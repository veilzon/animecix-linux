# Maintainer: veilzon <veilzon@users.noreply.github.com>
pkgname=animecix
pkgver=1.4.5
pkgrel=2
_commit=3b0c8b9daf92270a57676b51b4038bce0f2575e0
pkgdesc="Türkçe anime izleme uygulaması (GTK4/libadwaita + mpv)"
arch=('x86_64')
url="https://github.com/veilzon/animecix-linux"
license=('MIT')
depends=('gtk4' 'libadwaita' 'mpv' 'aria2' 'alsa-lib')
makedepends=('rust' 'cargo' 'git' 'cmake' 'clang' 'perl' 'nasm' 'zlib' 'pkgconf')
# Birlikte İzle test derlemesi: uygulama seviyesinde oda + içerik senkronu.
source=("$pkgname-$pkgver.tar.gz::https://codeload.github.com/veilzon/animecix-linux/tar.gz/$_commit"
        "yggstack-linux-amd64-0.0.5::https://github.com/DrewCyber/yggstack-ng/releases/download/v0.0.5/yggstack-linux-amd64")
sha256sums=('189d86e671072ffc293ea4beed1dbc8a86fa67f72447f14071ad962a5b12ae32'
            '533cca213caa459de362a500108c6697000c3b971fa1bc905d3c8ac3d42ff48a')
options=('!lto' '!debug')
install=animecix.install

build() {
  cd "animecix-linux-$_commit"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$srcdir/target}"
  cargo build --release --locked
}

package() {
  cd "animecix-linux-$_commit"
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/target}/release/animecix" "$pkgdir/usr/bin/animecix"
  install -Dm755 "${CARGO_TARGET_DIR:-$srcdir/target}/release/animecix-calendar" "$pkgdir/usr/bin/animecix-calendar"
  install -Dm755 "$srcdir/yggstack-linux-amd64-0.0.5" "$pkgdir/usr/bin/yggstack"
  install -Dm644 packaging/flatpak/io.github.veilzon.AnimeciX.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.veilzon.AnimeciX.metainfo.xml"

  mkdir -p "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/tr.com.animecix.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=AnimeciX
GenericName=Anime İzleme Uygulaması
Comment=Türkçe anime izleme istemcisi (mpv tabanlı)
Exec=animecix
Icon=tr.com.animecix
Terminal=false
Categories=AudioVideo;Video;GTK;
StartupWMClass=tr.com.animecix
Keywords=anime;video;player;izle;
EOF

  for s in 64 128 256 512; do
    install -Dm644 "assets/icon-$s.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/tr.com.animecix.png"
  done

  install -Dm644 assets/ATTRIBUTION-Adwaita.md \
    "$pkgdir/usr/share/animecix/ATTRIBUTION-Adwaita.md"
  if [[ -f assets/ATTRIBUTION-yggstack.md ]]; then
    install -Dm644 assets/ATTRIBUTION-yggstack.md \
      "$pkgdir/usr/share/animecix/ATTRIBUTION-yggstack.md"
  else
    install -d "$pkgdir/usr/share/animecix"
    cat > "$pkgdir/usr/share/animecix/ATTRIBUTION-yggstack.md" <<'EOF'
# yggstack (yggstack-ng)

- Proje: https://github.com/DrewCyber/yggstack-ng
- Sürüm: v0.0.5
- Kaynak kodu: https://github.com/DrewCyber/yggstack-ng/tree/v0.0.5
- Lisans: MPL-2.0 - https://mozilla.org/MPL/2.0/
EOF
  fi
  mkdir -p "$pkgdir/usr/share/animecix/assets"
  cp -r assets/upscale "$pkgdir/usr/share/animecix/assets/"
  cp -r assets/hicolor "$pkgdir/usr/share/animecix/assets/"
  cp -r assets/changelog "$pkgdir/usr/share/animecix/assets/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
